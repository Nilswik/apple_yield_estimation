# Only what is needed to RUN the system goes in the repo. Everything else (data, notebooks, debug and
# evaluation scripts, generated results) stays local. To add a file, put a "!path" line in the list below.
# Note: gitignore has no end-of-line comments, so every comment sits on its own line.

# ignore everything...
*
# ...but still look inside folders, so single files can be let back in
!*/
# do not even walk into these (big, never needed)
.venv/
Archive/
Development/
__pycache__/

# ---- needed to run (everything the working version uses lives in Main/)
!.gitignore
!CLAUDE.md
!/README.md
!INSTRUKTIONER.md
!HOW_IT_WORKS.md
!requirements.txt
!Results/pipeline_3d/README.md
# the pipeline, its drawing module and the OAK-D snapshot script
!Main/pipeline_3d.py
!Main/visualize.py
!Main/oak_d_snapshots.py
# detectors: run 1 (Orbbec, used by pipeline_3d.py) and run 2b (OAK-D, used by oak_d_snapshots.py)
!Main/models/apple_run1.pt
!Main/models/apple_run2b.pt
# size calibration (+ the calibration apples, the fallback when a recording has too few measurable apples)
!Main/calibration/calibration.json
!Main/calibration/fully_visible_apples.csv
# hand-marked apples, for --evaluate
!Main/annotations/*_points.csv
CLAUDE.md
